# AI Control Plane deployment settings for scripts/deploy.sh.
#
#   cp deploy.env.example deploy.env    # deploy.env is ignored by git; keep your values there
#   scripts/deploy.sh
#
# The file is read by bash: keep the KEY="value" form and quote values that contain spaces.

# ------------------------------------------------------------------ required
PROJECT_ID="your-project-id"                 # Google Cloud project to monitor and deploy into
REGION="asia-northeast3"                     # Cloud Run, Artifact Registry and settings bucket region
ADMIN_EMAILS="admin@example.com"        # administrators (comma separated, *@example.com allowed)

# ------------------------------------------------------------------ service
SERVICE_NAME="ai-control-plane"              # Cloud Run service name (also used to name related resources)
ORGANIZATION_NAME="Your Organization"        # shown in the header and on the sign-in page
DEFAULT_LOCALE="ko"                          # ko | en (each user can switch in the UI)
WORKSPACE_TIMEZONE="Asia/Seoul"              # IANA time zone for dates, daily buckets and the scheduler

# ------------------------------------------------------------------ sign-in (ACCESS_MODE)
# google        Built-in sign-in page with Google accounts. No OAuth client needed (recommended).
#               A small sign-in bridge service behind Identity-Aware Proxy verifies the Google account;
#               the dashboard then admits only approved accounts. Others can request access and
#               administrators approve them in Settings > Access control.
# google_oauth  Built-in sign-in page with your own OAuth client (OAUTH_CLIENT_JSON).
#               Authorized redirect URI of the client: <dashboard URL>/auth/google/callback
# iap           Identity-Aware Proxy in front of the dashboard; IAP_MEMBERS may open it.
ACCESS_MODE="google"
ALLOWED_USERS=""                             # google modes: approved viewers, e.g. "*@example.com,partner@example.org"
IAP_MEMBERS=""                               # iap mode: "group:ai-governance@example.com,user:someone@example.com"
OAUTH_CLIENT_JSON=""                         # google_oauth mode: path to the downloaded client JSON (never commit it)
BRIDGE_MEMBERS="allAuthenticatedUsers"       # google mode: who may pass the bridge's IAP; use "domain:example.com"
                                             # if an organization policy restricts allAuthenticatedUsers
PUBLIC_BASE_URL=""                           # optional custom domain, e.g. https://ai-governance.example.com

# ------------------------------------------------------------------ data sources
AUDIT_DATASET="ge_analytics"                 # BigQuery dataset that receives the AI audit logs
CREATE_LOG_SINK="true"                       # create the dataset and the Log Router sink (true | false)
DATASET_LOCATION="US"                        # location of a newly created dataset
ENABLE_DATA_ACCESS_LOGS="false"              # turn on Data Access audit logs for Vertex AI, Discovery Engine
                                             # and Model Armor (adds Cloud Logging volume and cost)
BILLING_PROJECT_ID=""                        # project of the billing export (empty = PROJECT_ID)
BILLING_DATASET=""                           # billing export dataset, e.g. billing_detailed_usage
BILLING_TABLE=""                             # gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX
BILLING_ACCOUNT_ID=""                        # XXXXXX-XXXXXX-XXXXXX
DISCOVERY_ENGINE_LOCATIONS="global"          # Gemini Enterprise locations (comma separated: global,us,eu)
AGENT_ENGINE_REGIONS="us-central1"           # Agent Engine regions (comma separated)

# ------------------------------------------------------------------ governance (Antigravity per-user caps)
ENABLE_GOVERNANCE_ACTIONS="false"            # grant IAM write roles so caps can suspend and restore users
ENFORCEMENT_SCHEDULE=""                      # e.g. "*/15 * * * *": scheduled enforcement runs (needs
                                             # ENABLE_GOVERNANCE_ACTIONS=true and ACCESS_MODE google or google_oauth)

# ------------------------------------------------------------------ optional
AI_DEFAULT_MODEL=""                          # AI Analyst model (empty = config.yaml default)
IMAGE=""                                     # prebuilt image; empty = build with Cloud Build
MEMORY="1Gi"
CPU="1"
MIN_INSTANCES="0"
MAX_INSTANCES="3"
