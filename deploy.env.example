# AI Control Plane deployment settings for scripts/deploy.sh (optional — scripts/install.sh and
# scripts/deploy.sh --project PROJECT_ID also run directly without creating this file).
#
#   cp deploy.env.example deploy.env    # deploy.env is ignored by git; keep your values there
#   scripts/deploy.sh
#
# The file is read by bash: keep the KEY="value" form and quote values that contain spaces.

# ------------------------------------------------------------------ required
PROJECT_ID="your-project-id"                 # Google Cloud project ID (lowercase ID, not Display Name)
SCAN_PROJECTS=""                             # optional: comma-separated secondary project IDs monitored together in this dashboard (--link-projects)
SCAN_ALL_PROJECTS="true"                     # auto-discover additional readable GCP projects via Cloud Resource Manager (true | false)
PREPARE_LINKED_PROJECTS="true"               # best-effort enable AI logs & sink on SCAN_PROJECTS when caller has access (true | false)
REGION="asia-northeast3"                     # Cloud Run, Artifact Registry, Secret Manager and bucket region
ADMIN_EMAILS=""                              # administrators (comma separated, *@example.org allowed; empty = active gcloud account)

# ------------------------------------------------------------------ service
SERVICE_NAME="ai-control-plane"              # Cloud Run service name (also used to name related resources)
ORGANIZATION_NAME="Your Organization"        # shown in header & sign-in page ("Your Organization" = auto-detected from GCP Org / Project)
DEFAULT_LOCALE="ko"                          # ko | en (each user can switch in the UI)
WORKSPACE_TIMEZONE="Asia/Seoul"              # IANA time zone for dates, daily buckets and the scheduler

# ------------------------------------------------------------------ sign-in (ACCESS_MODE)
# google        Built-in sign-in page with Google accounts. No OAuth client needed (recommended).
#               Automatically falls back to Direct Cloud Run IAP or built-in ID/Password when org policies require it.
# google_oauth  Built-in sign-in page with your own OAuth client (OAUTH_CLIENT_JSON).
# iap           Identity-Aware Proxy directly in front of the dashboard; IAP_MEMBERS may open it.
# password      Built-in ID/Password sign-in page only. Account 'admin' gets a random initial password per deployment in
#               Secret Manager (${SERVICE_NAME}-admin-password; deploy prints the command to read it). Change it and
#               create customer accounts in Settings > Access control. There is no shared default password.
ACCESS_MODE="google"
ALLOWED_USERS=""                             # approved viewers, e.g. "*@example.org,partner@example.org" (alias: INITIAL_VIEWERS)
IAP_MEMBERS=""                               # iap mode: "group:ai-governance@example.org,user:someone@example.org"
OAUTH_CLIENT_JSON=""                         # google_oauth mode: path to the downloaded client JSON (never commit it)
BRIDGE_MEMBERS="allAuthenticatedUsers"       # google mode: who may pass the bridge's IAP; explicit admin/viewer domains are always bound too
PUBLIC_BASE_URL=""                           # optional custom domain, e.g. https://ai-governance.example.org
GUEST_ACCESS="false"                         # demo only: true lets anyone with the link browse read-only with identifiers hidden
GUEST_REDACT_TERMS=""                        # demo only: extra comma-separated terms hidden from guests; default: .prepublish-terms

# ------------------------------------------------------------------ data sources (all enabled by default)
AUDIT_DATASET="ge_analytics"                 # BigQuery dataset that receives the AI audit logs
CREATE_LOG_SINK="true"                       # create or update the dataset and the Log Router sink (true | false)
DATASET_LOCATION="asia-northeast3"           # location of a newly created dataset (default: REGION)
ENABLE_DATA_ACCESS_LOGS="true"               # turn on Data Access audit logs across all 7 AI services (true | false)
ENABLE_GE_OBSERVABILITY="true"               # turn on usage logs (observability) of every Gemini Enterprise app
GE_PROMPT_LOGGING="true"                     # turn on sensitiveLoggingEnabled so user identities and prompts are recorded
BILLING_PROJECT_ID=""                        # project of the billing export (empty = auto-detect in PROJECT_ID; if absent, token-based cost estimation runs automatically)
BILLING_DATASET=""                           # billing export dataset (empty = auto-detect gcp_billing_export_*)
BILLING_TABLE=""                             # gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX (empty = auto-detect)
BILLING_ACCOUNT_ID=""                        # XXXXXX-XXXXXX-XXXXXX (empty = auto-detect from project billing link)
DISCOVERY_ENGINE_LOCATIONS=""                # Gemini Enterprise locations, e.g. "global,us"; empty = auto-detect
AGENT_ENGINE_REGIONS=""                      # Agent Engine regions (comma separated; empty = auto-detect from REGION)

# ------------------------------------------------------------------ modules
DISABLED_MODULES=""                          # modules hidden at deploy time, comma separated
                                             # overview, gemini_enterprise, notebooklm, model_usage, agent_gateway,
                                             # agent_registry, agent_deployments, model_armor, users, antigravity,
                                             # finops, telemetry, analyst

# ------------------------------------------------------------------ governance & schedules
ENABLE_GOVERNANCE_ACTIONS="true"             # grant IAM write roles so User 360 & Antigravity controls work out of the box
ENFORCEMENT_SCHEDULE="*/5 * * * *"           # Antigravity cap enforcement runs (stop within 5 minutes, restore at each reset); "off" disables
MAINTENANCE_SCHEDULE="*/15 * * * *"          # Cloud Scheduler tick for scheduled work ("off" to disable): the daily official
                                             # token price & exchange-rate check and the telemetry route budget guard
PRICING_SYNC_TIME=""                         # local time of the daily price check (empty = 00:00); also editable in
                                             # Settings > Data collection and cost
PRICING_CURRENCY=""                          # display currency of token-based cost estimates, ISO code such as KRW or EUR
                                             # (empty = the Antigravity cost-cap currency, else USD)

# ------------------------------------------------------------------ telemetry extensions
TELEMETRY_AI_MODEL=""                        # Gemini model that describes and groups telemetry sources (empty = gemini-4-argon)
TELEMETRY_DATASET=""                         # BigQuery dataset for telemetry routes (empty = telemetry_routed)

# ------------------------------------------------------------------ optional
AI_DEFAULT_MODEL=""                          # AI Analyst model (empty = config.yaml default)
AI_LOCATION=""                               # Agent Platform model endpoint location (empty = auto-detect global / REGION)
IMAGE=""                                     # prebuilt image; empty = build with Cloud Build (with local Docker fallback)
MEMORY="1Gi"
CPU="1"
MIN_INSTANCES="0"
MAX_INSTANCES="3"
