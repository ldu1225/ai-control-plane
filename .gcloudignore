# Files uploaded by `gcloud builds submit` (scripts/deploy.sh) and `gcloud run deploy --source`.
# Every git-ignored file is excluded first; then an allowlist uploads only what the container build
# needs (Dockerfile, .dockerignore, requirements.txt, config.yaml and src/). Local configuration,
# engagement documents, evaluation files, tests and Terraform stay on this computer.
#!include:.gitignore
/*
!/Dockerfile
!/.dockerignore
!/requirements.txt
!/config.yaml
!/src/
**/__pycache__
**/*.py[cod]
**/.DS_Store
*.log
