# Example input values. Copy to terraform.tfvars (ignored by git) and edit.
# All values below are placeholders.

project_id      = "your-gcp-project-id"
region          = "us-central1"
container_image = "us-central1-docker.pkg.dev/your-gcp-project-id/ai-control-plane/ai-control-plane:2.0.0"

audit_dataset_id   = "ge_analytics"
billing_project_id = ""
billing_dataset_id = "billing_detailed_usage"
billing_table_id   = "gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX"
billing_account_id = ""

workspace_timezone = "UTC"
organization_name  = "Your Organization"
product_name       = "AI Control Plane"
default_locale     = "en"

discovery_engine_locations = ["global"]
agent_engine_regions       = ["us-central1"]

auth_mode    = "iap"
enable_iap   = true
iap_members  = ["group:ai-governance@example.com"]
admin_emails = ["admin@example.com"]

ai_default_model = "gemini-3.8-flash"
ai_location      = "global"

# Grants roles/resourcemanager.projectIamAdmin, roles/logging.logWriter and roles/iam.roleAdmin.
enable_governance_actions = false

# Optional: numeric organization id to detect inherited (folder/organization) grants.
organization_id = ""
